# Copy to .env and fill in. NEVER commit .env with real values.
# eBay Developers Program (https://developer.ebay.com) -> your app's keys
EBAY_APP_ID=
EBAY_CERT_ID=
# eBay Partner Network campaign ID for affiliate links (optional for now)
EBAY_CAMPID=
# Postgres connection string
DATABASE_URL=postgresql://breaks:breaks@localhost:5432/breaks
# YouTube Data API v3 key (Phase 2)
YOUTUBE_API_KEY=
# YouTube channel-roster poller tuning (optional; defaults shown)
# YOUTUBE_ROSTER_MAX_CHANNELS=300
# YOUTUBE_ROSTER_VIDEOS_PER_CHANNEL=10
# Twitch developer app (dev.twitch.tv/console) -> Client ID + Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
